#!/bin/bash
#PBS -q auto_free
#PBS -j oe
#PBS -k oed
#PBS -N PageRank_Build
#PBS -l walltime=00:15:00
#PBS -l select=1:ncpus=4:mem=16gb

cd $PBS_O_WORKDIR

module purge
module load nvhpc
module load openmpi/gcc/64/4.1.8
module load CMake

# Force CMake to use the NVIDIA HPC compilers
export CC=nvc
export CXX=nvc++

mkdir -p build
cd build

cmake ..
make -j4